{
    "pages": [
        {
            "path": "pages/index/index",
            "style": {
                "navigationBarTitleText": "法律助手",
                "navigationBarBackgroundColor": "#1a6fb5",
                "navigationBarTextStyle": "white"
            }
        },
        {
            "path": "pages/product/list",
            "style": {
                "navigationBarTitleText": "法律服务",
                "navigationBarBackgroundColor": "#1a6fb5",
                "navigationBarTextStyle": "white"
            }
        },
        {
            "path": "pages/product-detail/detail",
            "style": {
                "navigationBarTitleText": "产品详情",
                "navigationBarBackgroundColor": "#ffffff",
                "navigationBarTextStyle": "dark"
            }
        },
        {
            "path": "pages/order-confirm/confirm",
            "style": {
                "navigationBarTitleText": "确认下单",
                "navigationBarBackgroundColor": "#ffffff",
                "navigationBarTextStyle": "dark"
            }
        },
        {
            "path": "pages/order-detail/detail",
            "style": {
                "navigationBarTitleText": "订单详情",
                "navigationBarBackgroundColor": "#1a6fb5",
                "navigationBarTextStyle": "white"
            }
        },
        {
            "path": "pages/order-list/list",
            "style": {
                "navigationBarTitleText": "我的订单",
                "navigationBarBackgroundColor": "#1a6fb5",
                "navigationBarTextStyle": "white"
            }
        },
        {
            "path": "pages/user/index",
            "style": {
                "navigationBarTitleText": "个人中心",
                "navigationBarBackgroundColor": "#1a6fb5",
                "navigationBarTextStyle": "white"
            }
        }
    ],
    "globalStyle": {
        "navigationBarTextStyle": "dark",
        "navigationBarTitleText": "法律助手",
        "backgroundColor": "#f5f5f5",
        "backgroundTextStyle": "light"
    },
    "tabBar": {
        "color": "#999999",
        "selectedColor": "#1a6fb5",
        "borderStyle": "white",
        "backgroundColor": "#ffffff",
        "list": [
            {
                "pagePath": "pages/index/index",
                "iconPath": "static/tab/home.png",
                "selectedIconPath": "static/tab/home-active.png",
                "text": "首页"
            },
            {
                "pagePath": "pages/product/list",
                "iconPath": "static/tab/product.png",
                "selectedIconPath": "static/tab/product-active.png",
                "text": "服务"
            },
            {
                "pagePath": "pages/order-list/list",
                "iconPath": "static/tab/order.png",
                "selectedIconPath": "static/tab/order-active.png",
                "text": "订单"
            },
            {
                "pagePath": "pages/user/index",
                "iconPath": "static/tab/user.png",
                "selectedIconPath": "static/tab/user-active.png",
                "text": "我的"
            }
        ]
    },
    "easycom": {
        "autoscan": true,
        "custom": {
            "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue"
        }
    }
}
