# 服务端口
PORT=3000

# JWT密钥（管理后台登录用，生产环境请改成随机字符串）
JWT_SECRET=change_this_to_random_string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# 微信小程序（上线时填写）
WX_APPID=your_appid
WX_APPSECRET=your_appsecret

# 微信支付（上线时填写）
WX_MCHID=your_mchid
WX_API_V3_KEY=your_api_v3_key
WX_NOTIFY_URL=https://your-domain.com/api/orders/pay-notify
WX_MCH_SERIAL_NO=your_serial_no
